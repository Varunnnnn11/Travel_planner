# Google Gemini (https://aistudio.google.com/apikey). Leave empty to use the offline demo planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (Project Settings -> API). Leave empty to store trips in backend/data/trips.json.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
